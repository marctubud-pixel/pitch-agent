{
  "name": "pitch-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "npm --prefix apps/workbench-preview run dev -- --host 127.0.0.1 --port 4420 --strictPort",
    "setup:frontend": "npm --prefix apps/workbench-preview ci --ignore-scripts",
    "check:specs": "python3 scripts/check-specs.py && python3 scripts/check-specs.test.py",
    "check:repository": "python3 scripts/check-repository.py && python3 scripts/check-repository.test.py",
    "typecheck": "npm --prefix apps/workbench-preview run typecheck",
    "test:frontend": "npm --prefix apps/workbench-preview test",
    "test:core": "node --test tools/workbench/store-codec.test.mjs tools/workbench/case-identity.test.mjs tools/workbench/schema-enum-partition.test.mjs tools/local-acceptance/client-flow.test.mjs tools/local-acceptance/browser-pending.test.mjs tools/local-acceptance/reference-input-controller.test.mjs tools/auto-layout/native-charts/chart-data.test.mjs",
    "test:backend:legacy": "npm run test:domain",
    "build": "npm --prefix apps/workbench-preview run build",
    "check": "npm run check:specs && npm run check:repository && npm run typecheck && npm run test:frontend && npm run test:core && npm run test:domain && npm run test:brief-http && npm run test:research-contract && npm run test:dependency && npm run build",
    "test:domain": "node --test tools/workbench/project.test.mjs",
    "test:dependency": "node scripts/check-pptx-dependency.mjs",
    "dev:brief": "node tools/workbench/brief-server.mjs --db .data/brief-workbench.sqlite --port 4182 --origin http://127.0.0.1:4420",
    "dev:http": "node scripts/dev-http.mjs",
    "test:brief-http": "node --test tools/workbench/brief-server.test.mjs tools/workbench/brief-intake-service.test.mjs tools/workbench/brief-original-http.test.mjs tools/workbench/brief-extraction-http.test.mjs tools/workbench/intake-python-environment.test.mjs",
    "test:research-contract": "node --test tools/workbench/seven-stage-workflow.test.mjs tools/workbench/research-method.test.mjs tools/workbench/research-service.test.mjs tools/workbench/research-reader-loop.test.mjs tools/workbench/research-reader-state.test.mjs tools/workbench/research-reader-service.test.mjs tools/workbench/research-reader-http.test.mjs tools/workbench/reader-correction.test.mjs tools/workbench/reader-handoff.test.mjs tools/workbench/reader-queued-recovery.test.mjs tools/workbench/reader-acquired-history.test.mjs"
  }
}
