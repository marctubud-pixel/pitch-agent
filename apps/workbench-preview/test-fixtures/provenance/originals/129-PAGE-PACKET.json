      ],
      "gaps": [
        "地域参考对工位茶歇机制的适用性尚未评审",
        "主副文在实际瓶标同读时的理解未核",
        "青屿展示面、尺寸及品牌图形资产待补"
      ],
      "referenceIds": [
        "trip-longjing",
        "trip-changbai"
      ]
    },
    {
      "id": "v2",
      "visualQuestion": "既有称呼和相伴关系参考对“认出虎跑名字、想起曾同行的人、因此捎茶”这条现有文案因果链能提供哪些待核线索，如何区分关系表达与已证实的赠礼/社交效果？",
      "focus": [
        "看见地名与想起特定对象的因果关系",
        "主副文及既有随茶留言的用途差别",
        "称呼、相伴关系作为局部借鉴的范围"
      ],
