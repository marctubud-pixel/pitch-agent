+/**
+ * Where the docked tab can sit without covering anything. When the page is still (after a scroll,
+ * a resize, a route change or new content), it measures what is on screen (every control and every
+ * painted line of text) and picks the lowest place on the right edge where the tab overlaps none
+ * of it, trying the full tab first and a slimmer handle second. While the page scrolls the tab moves
+ * aside (and takes no taps) and comes back once the page settles.
+ */
+const TAB_H = 44;
+const TAB_W = { full: 30, slim: 16 } as const;
+const CONTROLS = 'a[href], button, input, textarea, select, summary, [role=tab], [role=button], [role=radio], [tabindex]:not([tabindex="-1"])';
+type TabSlot = { bottom: number; size: 'full' | 'slim' } | null;
+
+function findTabSlot(): TabSlot {
+  const W = window.innerWidth;
+  const H = window.innerHeight;
+  const top = (document.querySelector('.topbar')?.getBoundingClientRect().bottom ?? 0) + 8;
+  const boxes: Array<{ l: number; r: number; t: number; b: number }> = [];
+  const keep = (r: DOMRect) => {
+    if (r.width > 0 && r.height > 0 && r.bottom > top && r.top < H && r.right > W - TAB_W.full - 1) boxes.push({ l: r.left, r: r.right, t: r.top, b: r.bottom });
+  };
+  for (const el of document.querySelectorAll(CONTROLS)) {
+    if (el.closest('.workbot, .workbot-tab, .workbot-launcher, .workbot-hide')) continue;
+    for (const r of el.getClientRects()) keep(r);
+  }
+  const main = document.querySelector('main');
+  if (main) {
+    const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
+    const range = document.createRange();
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      if (!n.textContent?.trim()) continue;
+      range.selectNodeContents(n);
+      for (const r of range.getClientRects()) keep(r);
+    }
+  }
+  const free = (left: number, t: number, b: number) => boxes.every((x) => x.r <= left || x.l >= W || x.b <= t || x.t >= b);
