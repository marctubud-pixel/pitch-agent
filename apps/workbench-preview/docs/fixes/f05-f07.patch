+}
+.pw-rev > .btn { justify-self: start; }
+.pw-checkpoint .pw-rev { margin: 0 0 14px; background: transparent; }
+@media (max-width: 640px) {
+  .pw-rev__steps > li { grid-template-columns: 1fr; }
+}
+.pw-compare {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
