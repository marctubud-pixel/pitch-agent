+/** What the shared "needs you" items are made of, for wording the count (proposal/needs.ts decides the count). */
+function needsParts(needs: ReturnType<typeof needsYou>) {
+  let brief = false;
+  let decide = 0;
+  let revise = 0;
+  let facts: number | null = null;
+  for (const x of needs) {
+    if (x.kind === 'brief') brief = true;
+    else if (x.kind === 'decide') decide += 1;
+    else if (x.kind === 'revise') revise += 1;
+    else facts = x.count;
+  }
+  return { brief, decide, revise, facts };
+}
+
+/** The whole brief, read-only: the task extras and the working brief's own fields, where set. */
+function FullBrief({ proposal: p, brief }: { proposal: Proposal; brief: Brief | null }) {
+  const t = useT();
+  const rows: Array<{ key: string; label: string; value: ReactNode }> = [];
+  const add = (key: string, label: string, v: string | string[] | null | undefined) => {
+    if (Array.isArray(v) ? v.length === 0 : !v) return;
+    rows.push({
+      key,
+      label,
+      value: Array.isArray(v) ? (
+        <ul className="ov-lines">
+          {v.map((x) => (
+            <li key={x}>{x}</li>
+          ))}
+        </ul>
+      ) : (
+        v
+      ),
+    });
+  };
+  add('output', t('pw.brief.output'), p.task.output);
+  add('occasion', t('pw.brief.occasion'), p.task.occasion);
+  add('scope', t('pw.brief.scope'), p.task.scope);
+  add('objectives', t('taskField.objectives'), brief?.objectives);
+  add('audience', t('taskField.audience'), brief?.audience);
+  add('brand', t('taskField.brand'), brief?.brand);
+  add('constraints', t('taskField.constraints'), brief?.constraints);
+  add('deliverables', t('taskField.deliverables'), brief?.deliverables);
+  add('timeline', t('taskField.timeline'), brief?.timeline);
+  add('budget', t('taskField.budget'), brief?.budget);
+  add('openQuestions', t('taskField.openQuestions'), brief?.openQuestions);
+  return (
+    <dl className="ov-fullbrief">
+      {rows.map((r) => (
+        <div key={r.key}>
+          <dt>{r.label}</dt>
+          <dd>{r.value}</dd>
+        </div>
+      ))}
+    </dl>
+  );
+}
