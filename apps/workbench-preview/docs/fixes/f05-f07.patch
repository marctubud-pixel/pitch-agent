+/** True while a media query matches (phones, for the launcher's reading and typing behaviour). */
+function useMedia(query: string) {
+  const get = () => (typeof window !== 'undefined' && window.matchMedia ? window.matchMedia(query).matches : false);
+  const [match, setMatch] = useState(get);
+  useEffect(() => {
+    const mq = window.matchMedia?.(query);
+    if (!mq) return;
+    const on = () => setMatch(mq.matches);
+    on();
+    mq.addEventListener('change', on);
+    return () => mq.removeEventListener('change', on);
+  }, [query]);
+  return match;
+}
+
+const EDITABLE = 'input:not([type=checkbox]):not([type=radio]):not([type=button]):not([type=submit]):not([type=range]), textarea, select, [contenteditable="true"]';
+
+/** True while the person is typing in a field on the page (not in WorkBot's own panel). */
+function useTyping(enabled: boolean) {
+  const [typing, setTyping] = useState(false);
+  useEffect(() => {
+    if (!enabled) {
+      setTyping(false);
+      return;
+    }
+    const check = () => {
+      const el = document.activeElement;
+      setTyping(Boolean(el && el.matches(EDITABLE) && !el.closest('.workbot')));
+    };
+    const off = () => window.setTimeout(check, 0);
+    document.addEventListener('focusin', check);
+    document.addEventListener('focusout', off);
+    check();
+    return () => {
+      document.removeEventListener('focusin', check);
+      document.removeEventListener('focusout', off);
+    };
+  }, [enabled]);
+  return typing;
+}
+
+/** True while the page is being scrolled, and for a moment after: the person is reading. */
+function useReading(enabled: boolean) {
+  const [reading, setReading] = useState(false);
+  useEffect(() => {
+    if (!enabled) {
+      setReading(false);
+      return;
+    }
+    let timer = 0;
+    const on = () => {
+      setReading(true);
+      window.clearTimeout(timer);
+      timer = window.setTimeout(() => setReading(false), 1500);
+    };
+    window.addEventListener('scroll', on, { passive: true });
+    return () => {
+      window.removeEventListener('scroll', on);
+      window.clearTimeout(timer);
+    };
+  }, [enabled]);
+  return reading;
+}
