diff -ruN proposal-workbench/src/proposal/revisions.test.ts /home/claude/proposal-workbench/src/proposal/revisions.test.ts
--- proposal-workbench/src/proposal/revisions.test.ts	1970-01-01 08:00:00.000000000 +0800
+++ /home/claude/proposal-workbench/src/proposal/revisions.test.ts	2026-11-03 08:10:05.628601418 +0800
@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'vitest';
+import { MockWorkbenchService } from '../services/mock/MockWorkbenchService';
+import { memoryStore } from '../services/mock/storage';
+import { MockProposalService } from '../services/proposal/MockProposalService';
+import { artworkRevision, ideaUsedIn, latestRevisionRequest } from './revisions';
+
+async function load(id: string, agentDelay = 0) {
+  const store = memoryStore();
+  const workbench = new MockWorkbenchService({ store, latency: { read: 0, write: 0 }, autoTick: false });
+  const proposals = new MockProposalService(workbench, store, { latency: 0, agentDelay });
+  return { proposals, p: (await proposals.findByWorkbenchId(id))! };
+}
+
+describe('artworkRevision', () => {
+  it('describes a recorded revision only from recorded data', async () => {
+    const { p } = await load('northline');
+    const b = p.visual!.branches.find((x) => x.directionId === 'B')!;
+    const r = artworkRevision(b)!;
+    expect(r.previous.version).toBe(1);
+    expect(r.current.version).toBe(2);
+    expect(r.request.challenge).toMatch(/season lives only in the headline/);
+    expect(r.response).toMatch(/put the cold into the terrain/);
+    expect(r.requirementChanges).toEqual([{ text: 'Season shown inside the image', before: false, after: true }]);
+    expect(r.review.previous.meetsRule).toBe(false);
+    expect(r.review.current.meetsRule).toBe(true);
+    expect(r.open).toEqual([]);
+  });
+
+  it('reports a check that only exists in the new version as added, not as changed', async () => {
+    const { p } = await load('northline');
+    const c = artworkRevision(p.visual!.branches.find((x) => x.directionId === 'C')!)!;
+    expect(c.requirementChanges).toEqual([{ text: 'Distinct from the other directions', before: null, after: true }]);
+  });
+
+  it('returns nothing when there is no previous version (no empty panel)', async () => {
+    const { p } = await load('northline');
+    expect(artworkRevision(p.visual!.branches.find((x) => x.directionId === 'A')!)).toBeNull();
+    const plum = (await load('plumtide')).p;
+    expect(plum.visual!.branches.map(artworkRevision)).toEqual([null, null, null]);
+  });
+});
+
+describe('ideaUsedIn', () => {
+  it('finds an idea that appears word for word in a direction', async () => {
+    const { p } = await load('northline');
+    expect(ideaUsedIn(p, p.contributions[0])).toEqual({ directionId: 'C' });
+    expect(ideaUsedIn(p, { ...p.contributions[0], text: 'Not in any direction' })).toBeNull();
+  });
+});
+
+describe('latestRevisionRequest', () => {
+  it('is empty without a request, and follows a request through the simulated round', async () => {
+    const { proposals, p } = await load('plumtide', 40);
+    expect(latestRevisionRequest(p, 'visual')).toBeNull();
+    const asked = await proposals.decide(p.id, 'visual', { kind: 'request_revision', comment: 'Make the knot real' });
+    const s1 = latestRevisionRequest(asked, 'visual')!;
+    expect(s1.request.comment).toBe('Make the knot real');
+    expect(s1.versions).toEqual([]);
+    await new Promise((r) => setTimeout(r, 120));
+    const back = (await proposals.getProposal(p.id))!;
+    const s2 = latestRevisionRequest(back, 'visual')!;
+    expect(back.stages.visual.status).toBe('waiting_for_you');
+    expect(s2.versions.length).toBe(1);
+    expect(s2.reviews[0].verdict).toMatch(/content unchanged/);
+    const approved = await proposals.decide(p.id, 'visual', { kind: 'approve', comment: '' });
+    expect(latestRevisionRequest(approved, 'visual')).toBeNull();
+  });
+});
diff -ruN proposal-workbench/src/proposal/revisions.ts /home/claude/proposal-workbench/src/proposal/revisions.ts
--- proposal-workbench/src/proposal/revisions.ts	1970-01-01 08:00:00.000000000 +0800
+++ /home/claude/proposal-workbench/src/proposal/revisions.ts	2026-11-03 08:05:02.892753543 +0800
@@ -0,0 +1,87 @@
+import type { Contribution, HumanDecision, Proposal, RefinedVisual, ReviewRecord, StageId, VersionRecord, VisualBranch } from '../domain/proposal';
+import { latestRefined } from './pending';
+
+/**
+ * Read-only views of revision records, built only from what the data holds. Nothing here infers a
+ * change, a review pass or a new artwork the data does not state; where the data is silent the
+ * result says so (`null` / empty), and the UI words it as "not recorded", never as "no change".
+ */
+
+const avgOf = (r: RefinedVisual) => (r.scores.length ? Math.round((r.scores.reduce((s, x) => s + x.score, 0) / r.scores.length) * 10) / 10 : null);
+const meetsRule = (r: RefinedVisual) => {
+  const a = avgOf(r);
+  return a !== null && a >= 4 && r.requirements.every((q) => q.met);
+};
+
+/** One revision of a direction's refined artwork: the version before and the current one. */
+export interface ArtworkRevision {
+  previous: RefinedVisual;
+  current: RefinedVisual;
+  /** Why the previous version did not stand, as recorded: its upheld challenge and/or its failed acceptance rule. */
+  request: { challenge: string | null; unmet: string[]; average: number | null; belowAverage: boolean };
+  /** The recorded response to that challenge (its resolution), if any. */
+  response: string | null;
+  /** Requirement results that differ between the two versions, and checks added in the current one. */
+  requirementChanges: Array<{ text: string; before: boolean | null; after: boolean }>;
+  review: { previous: { average: number | null; meetsRule: boolean; status: RefinedVisual['status'] }; current: { average: number | null; meetsRule: boolean; status: RefinedVisual['status'] } };
+  /** Open points recorded against the current version. */
+  open: Array<{ kind: 'requirement'; text: string } | { kind: 'below'; average: number } | { kind: 'challenge'; text: string; outcome: 'upheld' | 'partly_upheld' }>;
+}
+
+export function artworkRevision(b: VisualBranch): ArtworkRevision | null {
+  const current = latestRefined(b);
+  if (!current) return null;
+  const i = b.refined.indexOf(current);
+  if (i < 1) return null;
+  const previous = b.refined[i - 1];
+  const ch = previous.challenge && previous.challenge.outcome !== 'rejected' ? previous.challenge : null;
+  const pAvg = avgOf(previous);
+  const before = new Map(previous.requirements.map((r) => [r.text, r.met]));
+  const requirementChanges = current.requirements
+    .filter((r) => !before.has(r.text) || before.get(r.text) !== r.met)
+    .map((r) => ({ text: r.text, before: before.has(r.text) ? (before.get(r.text) as boolean) : null, after: r.met }));
+  const cAvg = avgOf(current);
+  const open: ArtworkRevision['open'] = [];
+  for (const r of current.requirements) if (!r.met) open.push({ kind: 'requirement', text: r.text });
+  if (cAvg !== null && cAvg < 4) open.push({ kind: 'below', average: cAvg });
+  if (current.challenge && current.challenge.outcome !== 'rejected') open.push({ kind: 'challenge', text: current.challenge.challenge, outcome: current.challenge.outcome });
+  return {
+    previous,
+    current,
+    request: { challenge: ch?.challenge ?? null, unmet: previous.requirements.filter((r) => !r.met).map((r) => r.text), average: pAvg, belowAverage: pAvg !== null && pAvg < 4 },
+    response: ch?.resolution ?? null,
+    requirementChanges,
+    review: { previous: { average: pAvg, meetsRule: meetsRule(previous), status: previous.status }, current: { average: cAvg, meetsRule: meetsRule(current), status: current.status } },
+    open,
+  };
+}
+
+/** Where an idea the person gave ended up, when the data shows it word for word in a direction's copy. */
+export function ideaUsedIn(p: Proposal, c: Contribution): { directionId: string } | null {
+  const text = c.text.trim();
+  if (!text) return null;
+  const d = p.themes?.directions.find((x) => x.slogan.trim() === text || x.copyLines.some((l) => l.trim() === text));
+  return d ? { directionId: d.id } : null;
+}
+
+/** The person's latest revision request for a stage, with what the data recorded after it. */
+export interface RevisionRequestState {
+  request: HumanDecision;
+  /** Version records of this stage made after the request. */
+  versions: VersionRecord[];
+  /** Review records of this stage made after the request. */
+  reviews: ReviewRecord[];
+}
+
+export function latestRevisionRequest(p: Proposal, stage: StageId): RevisionRequestState | null {
+  const req = [...p.decisions].reverse().find((d) => d.stage === stage && d.kind === 'revision_requested');
+  if (!req) return null;
+  // A later approval of the stage closes the request; it is then history, not something pending.
+  const closed = p.decisions.some((d) => d.stage === stage && d.kind !== 'revision_requested' && d.at > req.at);
+  if (closed) return null;
+  return {
+    request: req,
+    versions: p.versions.filter((v) => v.stage === stage && v.at > req.at),
+    reviews: p.reviews.filter((r) => r.stage === stage && r.at > req.at),
+  };
+}
