+  color: var(--ink);
+  font-size: var(--t-small);
+}
+.pw-evstate[data-tone='warn'] { background: var(--warn-wash); }
+.pw-evstate[data-tone='warn'] > svg { color: var(--warn); }
+.rs-rows tr[data-hl] > td { background: var(--accent-wash); }
+.rs-rows tr[data-hl] > td:first-child { box-shadow: inset 3px 0 0 var(--klein); }
+[data-focus^='arg-']:focus,
+[data-focus^='opp-']:focus,
+[data-focus^='circle-']:focus { outline: 2px solid var(--focus); outline-offset: 4px; border-radius: 16px; }
+
+/* ---- F03: what the decision is about ---- */
+.pw-cp-target {
+  display: grid;
+  gap: 10px;
+  margin: 4px 0 14px;
+  padding: 12px 0;
+  border-block: 1px solid var(--rule);
+}
+.pw-cp-target > div {
+  display: grid;
+  grid-template-columns: minmax(9rem, 11rem) 1fr;
+  gap: 4px 16px;
+  align-items: baseline;
+}
+.pw-cp-target dd {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 4px 6px;
+  margin: 0;
+  font-size: var(--t-body);
+}
+.pw-cp-target dd > .small { flex-basis: 100%; }
+.pw-cp-target dd > .btn { margin-top: 4px; }
+.pw-cp-target__note { flex-basis: 100%; }
+@media (max-width: 640px) {
+  .pw-cp-target > div { grid-template-columns: 1fr; }
+}
+.pw-pendingnote {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 10px;
+  margin: 0 0 12px;
+  padding: 10px 12px 10px 14px;
+  border-radius: 14px;
+  background: var(--pw-attn-wash);
+  color: var(--ink);
+  font-size: var(--t-small);
+}
+.pw-pendingnote > svg { color: var(--pw-attn); }
+.pw-pendingnote > span { flex: 1 1 14rem; }
+
+/* ---- F04: packaging views open whole and large ---- */
+.pw-view__label { display: inline-flex; align-items: center; gap: 4px; }
+.pw-viewbig {
+  display: grid;
+  justify-items: center;
+  gap: 10px;
+  margin: 0;
+}
+.pw-viewbig .art-frame {
+  width: min(100%, calc((100dvh - 190px) * var(--r)));
+  height: auto;
+}
+
+/* Scroll targets land below the sticky top bar, so their headings stay visible. */
+.pw-stage [data-focus],
+#vis-refined,
+#stage-work {
+  scroll-margin-top: calc(var(--topbar, 56px) + 16px);
