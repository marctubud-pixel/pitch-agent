+/* Long stage names in the decision panel wrap instead of widening it on phones. */
+@media (max-width: 640px) {
+  .pw-checkpoint .cluster .btn { white-space: normal; text-align: left; }
+}
+.pw-cp-target > div > * { min-width: 0; overflow-wrap: anywhere; }
