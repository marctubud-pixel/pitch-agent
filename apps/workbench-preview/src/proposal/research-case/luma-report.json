      "field": "audience"
    },
    {
      "id": "brief-questions",
      "kind": "brief",
      "text": "要解释适合分享的货架线索，以及竞品怎样传达口味与酒精度。",
      "field": "researchQuestions"
    },
    {
      "id": "brief-constraints",
      "kind": "brief",
